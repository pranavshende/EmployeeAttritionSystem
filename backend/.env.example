# Gemini API Key for AttritionAI Conversational & Hybrid RAG Assistant
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase PostgreSQL Database (via Prisma)
DATABASE_URL="postgresql://username:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional Server Configuration
PORT=5000
FLASK_ENV=production
